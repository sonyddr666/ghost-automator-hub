# .env.example
# Copia para .env e preenche os valores.
# O .env NUNCA sobe pro GitHub.

# ==========================================
# MODO PC (obrigatorio, nucleo do sistema)
# ==========================================
CHROME_USER_DATA=C:\Users\SEU_USUARIO\AppData\Local\Google\Chrome\User Data

# ==========================================
# MODO AVANCADO (desligado por padrao)
# Para ligar: muda false -> true
# ==========================================
ATIVAR_MODO_AVANCADO=false

# Sub-modulos (so importam se ATIVAR_MODO_AVANCADO=true)
ATIVAR_TELEGRAM=false
ATIVAR_API=false

# ==========================================
# CREDENCIAIS (so necessarias se os modulos acima estiverem ON)
# ==========================================

# Telegram: pega o token via @BotFather e o chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Porta da API REST (padrao 8000)
API_PORT=8000
