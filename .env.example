# .env.example
# Copia esse arquivo para .env e preenche os valores
# O .env NUNCA sobe pro GitHub (ja esta no .gitignore)

# Caminho do teu perfil do Chrome
CHROME_USER_DATA=C:\Users\SEU_USUARIO\AppData\Local\Google\Chrome\User Data

# Telegram Bot (via @BotFather)
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# Teu chat_id pessoal (via @userinfobot no Telegram)
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI
